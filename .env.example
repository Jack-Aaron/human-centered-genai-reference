HOST=127.0.0.1
PORT=3000
DB_PATH=./data/app.sqlite

GLOBAL_COOLDOWN_SECONDS=10
GLOBAL_DAILY_CAP=50
API_CLIENT_DAILY_CAP=20
API_CLIENT_RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=8192
AUTH_MAX_CLOCK_SKEW_SECONDS=300

# Optional external corpus source. The public sample file works locally.
EXTERNAL_CORPUS_URL=file://./data/sample-corpus.html
CORPUS_SNAPSHOT_PATH=./data/corpus-snapshot.json
CORPUS_MIN_ENTRIES=3
CORPUS_MAX_BYTES=1048576
CORPUS_FETCH_TIMEOUT_MS=5000
CORPUS_MAX_AGE_SECONDS=3600

# Optional standalone Slack endpoint.
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_COMMAND=/generate
