{
  "name": "human-centered-genai-reference",
  "version": "1.0.0",
  "private": false,
  "description": "Domain-agnostic reference architecture for human-centered generative AI evaluation and secure serving.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "genaictl": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
